{
    "name": "restruct/silverstripe-asset_icons",
    "description": "Category-coloured file-type icons and rendered preview thumbnails (PDF, SVG, EPS) for Silverstripe's Asset Admin and UploadField",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": ["silverstripe", "asset-admin", "icons", "thumbnails", "pdf"],
    "homepage": "https://github.com/restruct/silverstripe-asset_icons/",
    "authors": [
        {
            "name": "Restruct web & apps",
            "email": "dev@restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/asset-admin": "^2 || ^3",
        "restruct/silverstripe-simpler": "^0 || ^1",
        "restruct/xpdf-static": "~1.0"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\AssetIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\AssetIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
