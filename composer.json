{
    "name": "restruct/silverstripe-asset_icons",
    "description": "Colour-coded file-type icons for Silverstripe's Files section and UploadFields, plus optional rendered preview thumbnails for PDF, SVG and EPS files",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": ["silverstripe", "silverstripe-module", "silverstripe-cms", "asset-admin", "file-icons", "thumbnails", "pdf", "uploadfield"],
    "homepage": "https://github.com/restruct/silverstripe-asset_icons/",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/asset-admin": "^2 || ^3",
        "restruct/silverstripe-simpler": "^0 || ^1",
        "restruct/xpdf-static": "~1.0"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\AssetIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\AssetIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
