# Keep development-only files out of dist installs (Packagist zips). CI and local module work must
# therefore install this module as a PATH repository with symlink: true, or a real checkout -
# a dist install contains no tests at all.
/tests            export-ignore
/.github          export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/UPGRADING.md     export-ignore
# Dev tool that regenerates client/icons/*.svg from icons-source.svg; not needed at runtime
/client/extract-icons.py export-ignore
